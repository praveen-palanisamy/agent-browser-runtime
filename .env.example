# Required: shared bearer token orchestrators use to call the runner (>= 16 chars)
AGENT_RUNNER_TOKEN=change-me-to-a-long-random-string
# Absolute URL users reach the runner at (embedded live view during capture)
AGENT_RUNNER_PUBLIC_URL=http://localhost:8080
PORT=8080

# Providers: local | steel | kernel
AGENT_RUNNER_JOB_PROVIDER=local
AGENT_RUNNER_CAPTURE_PROVIDER=steel

# Steel (self-hosted https://github.com/steel-dev/steel-browser, Apache-2.0)
STEEL_API_URL=http://localhost:3000
# STEEL_API_KEY=          # Steel Cloud only

# Kernel (https://www.kernel.sh) — optional burst provider
# KERNEL_API_KEY=
# KERNEL_API_URL=https://api.onkernel.com

AGENT_RUNNER_CAPTURE_TTL_MS=1200000
AGENT_RUNNER_PACING=true
